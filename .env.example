# Servidor
SERVER_PORT=8080

# Banco de dados (localhost = via Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=consumo_real
DB_SSLMODE=disable
DB_TIMEZONE=America/Sao_Paulo

# Administrador base (criado automaticamente no primeiro boot)
ADMIN_BASE_NOME=Administrador
ADMIN_BASE_EMAIL=admin@consumoreal.com.br
ADMIN_BASE_SENHA=admin123

# Autenticação (JWT)
JWT_SECRET=consumo-real-server-dev-secret
TOKEN_TTL_HORAS=8
